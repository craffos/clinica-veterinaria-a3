          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{bearerToken}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"nome\": \"Max\",\n    \"id_especie\": 1,\n    \"id_raca\": 2,\n    \"sexo\": \"M\",\n    \"dt_nasc\": \"2023-05-15\",\n    \"porte\": \"MEDIO\",\n    \"id_tutor\": 1,\n    \"observacao\": \"Animal ficticio para teste de integracao A3\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/animais/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "animais",
            ""
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "    const id = pm.response.json().id_animal;",
              "    if (id) pm.collectionVariables.set(\"id_animal\", String(id));",
              "}"
            ]
          }
        }
      ]
    },
