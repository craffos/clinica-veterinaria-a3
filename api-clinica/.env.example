# Copie este arquivo para ".env" e ajuste as configuracoes.
# O arquivo ".env" nao deve ser publicado no GitHub.

# Banco de dados MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=clinica_veterinaria

# Chave secreta para assinatura dos tokens JWT.
# Gere uma chave exclusiva com:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# API Governamental Simulada
GOVERNO_URL=http://localhost:5001

# Chave de autenticacao entre as APIs.
# Gere uma chave aleatoria de 64 caracteres hexadecimais.
# Utilize a mesma chave no .env das duas APIs.
GOVERNO_API_KEY=