{
  "openapi": "3.0.3",
  "info": {
    "title": "API Governamental Simulada",
    "description": "API governamental simulada com banco independente, autenticação por API Key, idempotência e versionamento dos registros de animais.",
    "version": "1.3.0"
  },
  "servers": [
    {
      "url": "http://localhost:5001",
      "description": "Servidor local"
    }
  ],
  "tags": [
    {
      "name": "Animais",
      "description": "Cadastro/atualização de animais (upsert idempotente)."
    },
    {
      "name": "Vacinas",
      "description": "Registro de vacinas antirrábicas (idempotente)."
    }
  ],
  "components": {
    "schemas": {
      "Erro": {
        "type": "object",
        "properties": {
          "erro": {
            "type": "string"
          }
        }
      },
      "CadastroAnimal": {
        "type": "object",
        "required": [
          "chave_idempotencia",
          "id_animal_clinica",
          "nome",
          "especie",
          "versao_origem"
        ],
        "properties": {
          "chave_idempotencia": {
            "type": "string",
            "description": "UUID gerado pela clínica; reenviar com a mesma chave não duplica o registro"
          },
          "id_animal_clinica": {
            "type": "integer",
            "description": "id do animal no sistema da clínica"
          },
          "nome": {
            "type": "string"
          },
          "especie": {
            "type": "string"
          },
          "raca": {
            "type": "string",
            "nullable": true
          },
          "numero_microchip": {
            "type": "string",
            "nullable": true
          },
          "versao_origem": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "description": "Versão crescente da operação na clínica, preservada no reenvio."
          }
        }
      },
      "RegistroVacina": {
        "type": "object",
        "required": [
          "chave_idempotencia",
          "id_animal_clinica",
          "id_vacina_clinica",
          "data_aplicacao"
        ],
        "properties": {
          "chave_idempotencia": {
            "type": "string"
          },
          "id_animal_clinica": {
            "type": "integer",
            "description": "Identificador na clínica; o cadastro prévio no governo não é obrigatório."
          },
          "id_vacina_clinica": {
            "type": "integer",
            "description": "id da vacina no sistema da clínica"
          },
          "data_aplicacao": {
            "type": "string",
            "format": "date"
          },
          "lote": {
            "type": "string",
            "nullable": true
          },
          "numero_microchip": {
            "type": "string",
            "nullable": true,
            "pattern": "^[0-9]{15}$"
          },
          "nome_animal": {
            "type": "string",
            "nullable": true,
            "maxLength": 80
          },
          "nome_vacina": {
            "type": "string",
            "nullable": true,
            "maxLength": 100
          },
          "fabricante": {
            "type": "string",
            "nullable": true,
            "maxLength": 100
          },
          "id_veterinario_clinica": {
            "type": "integer",
            "nullable": true
          },
          "nome_veterinario": {
            "type": "string",
            "nullable": true,
            "maxLength": 150
          },
          "crmv": {
            "type": "string",
            "nullable": true,
            "maxLength": 20
          },
          "uf_crmv": {
            "type": "string",
            "nullable": true,
            "maxLength": 2
          }
        }
      },
      "ProtocoloResposta": {
        "type": "object",
        "properties": {
          "protocolo": {
            "type": "string",
            "example": "AN-20261125212457-ABCDEFGHIJKL"
          },
          "repetido": {
            "type": "boolean",
            "description": "true quando a chave_idempotencia já tinha sido recebida antes"
          },
          "animal_cadastrado": {
            "type": "boolean",
            "description": "Quando retornado no registro de vacina, indica se existe cadastro governamental do animal."
          }
        }
      },
      "AnimalRegistrado": {
        "type": "object",
        "properties": {
          "id_registro": {
            "type": "integer"
          },
          "id_animal_clinica": {
            "type": "integer"
          },
          "nome": {
            "type": "string"
          },
          "especie": {
            "type": "string"
          },
          "raca": {
            "type": "string",
            "nullable": true
          },
          "numero_microchip": {
            "type": "string",
            "nullable": true
          },
          "protocolo": {
            "type": "string"
          },
          "data_registro": {
            "type": "string"
          },
          "data_atualizacao": {
            "type": "string",
            "nullable": true
          },
          "versao_origem": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "Versão crescente da operação na clínica, preservada no reenvio."
          }
        }
      }
    },
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Chave configurada no ambiente GOVERNO_API_KEY. Não publique a chave real."
      }
    }
  },
  "paths": {
    "/": {
      "get": {
        "tags": [
          "Animais"
        ],
        "summary": "Verifica se a API está no ar",
        "responses": {
          "200": {
            "description": "No ar",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "mensagem": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/animais/": {
      "post": {
        "tags": [
          "Animais"
        ],
        "summary": "Cadastra ou atualiza um animal (idempotente)",
        "parameters": [
          {
            "name": "simular_falha",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "enum": [
                0,
                1
              ]
            },
            "description": "1 = devolve 503 de propósito, para testar o reenvio do lado da clínica"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CadastroAnimal"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Repetição idempotente, atualização ou versão anterior processada sem sobrescrever a atual",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProtocoloResposta"
                }
              }
            }
          },
          "201": {
            "description": "Registrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProtocoloResposta"
                }
              }
            }
          },
          "400": {
            "description": "Dados obrigatórios ausentes ou inválidos, incluindo versão",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "409": {
            "description": "Conflito de chave, versão, microchip ou integridade",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "503": {
            "description": "Autenticação indisponível ou falha simulada, quando aplicável",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "401": {
            "description": "API Key ausente ou inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        },
        "description": "A mesma chave com o mesmo conteúdo preserva o protocolo. Conteúdo diferente com a mesma chave gera conflito. Versões antigas não sobrescrevem registros mais recentes.",
        "security": [
          {
            "apiKeyAuth": []
          }
        ]
      }
    },
    "/animais/{id_animal_clinica}": {
      "get": {
        "tags": [
          "Animais"
        ],
        "summary": "Busca o registro de um animal",
        "parameters": [
          {
            "name": "id_animal_clinica",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnimalRegistrado"
                }
              }
            }
          },
          "404": {
            "description": "Animal não registrado no governo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "401": {
            "description": "API Key ausente ou inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "503": {
            "description": "Autenticação indisponível ou falha simulada, quando aplicável",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        },
        "security": [
          {
            "apiKeyAuth": []
          }
        ]
      }
    },
    "/vacinas/": {
      "post": {
        "tags": [
          "Vacinas"
        ],
        "summary": "Registra uma vacina antirrábica (idempotente)",
        "parameters": [
          {
            "name": "simular_falha",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "enum": [
                0,
                1
              ]
            },
            "description": "1 = devolve 503 de propósito, para testar o reenvio do lado da clínica"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegistroVacina"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Já tinha sido recebido antes: devolve o mesmo protocolo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProtocoloResposta"
                }
              }
            }
          },
          "201": {
            "description": "Registrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProtocoloResposta"
                }
              }
            }
          },
          "400": {
            "description": "Campo obrigatório faltando",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "409": {
            "description": "Conflito de idempotência, dados da vacina ou integridade",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "503": {
            "description": "Autenticação indisponível ou falha simulada, quando aplicável",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "401": {
            "description": "API Key ausente ou inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        },
        "description": "Recebe vacina antirrábica mesmo sem cadastro prévio do animal no governo. A associação ao registro governamental pode ocorrer posteriormente. Repetições compatíveis não duplicam a vacina. O payload pode incluir identificação do animal, microchip, vacina, fabricante e identificação profissional do veterinário.",
        "security": [
          {
            "apiKeyAuth": []
          }
        ]
      }
    },
    "/animais/microchip/{numero_microchip}": {
      "get": {
        "tags": [
          "Animais"
        ],
        "summary": "Consulta animal pelo número do microchip",
        "parameters": [
          {
            "name": "numero_microchip",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{15}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnimalRegistrado"
                }
              }
            }
          },
          "400": {
            "description": "Microchip inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "404": {
            "description": "Animal não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "401": {
            "description": "API Key ausente ou inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "503": {
            "description": "Autenticação indisponível ou falha simulada, quando aplicável",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        },
        "security": [
          {
            "apiKeyAuth": []
          }
        ]
      }
    }
  }
}