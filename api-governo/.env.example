# Copie este arquivo para ".env" e ajuste as configuracoes.
# O arquivo ".env" nao deve ser publicado no GitHub.

# Banco de dados MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=governo_simulado

# Chave de autenticacao entre as APIs.
# Utilize a mesma chave GOVERNO_API_KEY configurada
# no arquivo .env da API Clinica.
GOVERNO_API_KEY=